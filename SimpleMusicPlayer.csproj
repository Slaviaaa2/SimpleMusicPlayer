<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SimpleMusicPlayer</AssemblyName>
    <RootNamespace>SimpleMusicPlayer</RootNamespace>
    <Version>0.5.5</Version>
    <AssemblyVersion>0.5.5.0</AssemblyVersion>
    <FileVersion>0.5.5.0</FileVersion>
    <InformationalVersion>0.5.5</InformationalVersion>
    <Authors>zeros</Authors>
    <Company>zeros</Company>
    <Product>Simple Music Player</Product>
    <Description>Minimal cross-platform desktop music player with album loading, queue control, URL caching, and CLI startup options.</Description>
    <UseAppHost>true</UseAppHost>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="LibVLCSharp" Version="3.9.4" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <None Include="scripts\Install-Release.ps1">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>Install-SimpleMusicPlayer.ps1</TargetPath>
    </None>
    <None Include="scripts\Uninstall-Release.ps1">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>Uninstall-SimpleMusicPlayer.ps1</TargetPath>
    </None>
    <None Include="scripts\install-config.psd1">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>install-config.psd1</TargetPath>
    </None>
    <None Include="scripts\modules\**">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>modules\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64'">
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.2" />
  </ItemGroup>
</Project>
