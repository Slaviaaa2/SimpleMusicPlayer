export component AppWindow inherits Window {
    title: "Simple Music Player";
    icon: @image-url("../../../Assets/app-icon.png");
    preferred-width: 760px;
    preferred-height: 585px;
    min-width: 560px;
    min-height: 465px;
    background: #121212;

    in-out property <string> track-title: "Drop files or use Open.";
    in-out property <string> status: "Ready.";
    in-out property <string> queue-info: "Supports local files, album folders, and yt-dlp-backed URL playback.";
    in-out property <string> source-badge: "Standby";
    in-out property <string> current-index-text: "Track --";
    in-out property <string> queue-count-text: "Queue empty";
    in-out property <string> loop-mode-badge: "Loop All";
    in-out property <string> elapsed-text: "00:00";
    in-out property <string> remaining-text: "00:00";
    in-out property <string> source-input: "";
    in-out property <string> play-pause-content: "Play";
    in-out property <string> loop-button-content: "Loop: All";
    in-out property <string> queue-summary: "0 queued";
    in-out property <float> seek-value: 0;
    in-out property <float> seek-maximum: 1;
    in-out property <float> volume-value: 100;
    in-out property <bool> volume-muted: false;
    property <bool> volume-boost-held: false;
    property <int> volume-display: round(root.volume-value);
    property <color> volume-text-color: root.volume-muted
        ? #7A7A7A
        : (root.volume-value > 100 ? #C77DFF : #CFCFCF);

    in-out property <bool> is-play-pause-enabled: false;
    in-out property <bool> is-previous-enabled: false;
    in-out property <bool> is-next-enabled: false;
    in-out property <bool> is-open-enabled: true;
    in-out property <bool> is-add-album-enabled: true;
    in-out property <bool> is-reverse-queue-enabled: false;
    in-out property <bool> is-add-source-enabled: true;
    in-out property <bool> is-loop-enabled: true;
    in-out property <bool> is-source-input-enabled: true;
    in-out property <bool> is-seek-enabled: false;
    in-out property <bool> is-preparation-visible: false;

    in-out property <[QueueItemData]> queue: [];
    in-out property <[AlbumHistoryData]> album-history: [];
    in-out property <[TrackHistoryData]> track-history: [];

    // Modal dialog overlay (the Slint counterpart of DialogService.cs's
    // custom-styled dialog window). An empty cancel text hides the cancel
    // button, turning the dialog into a plain info box.
    in-out property <bool> dialog-visible: false;
    in-out property <string> dialog-title: "";
    in-out property <string> dialog-message: "";
    in-out property <string> dialog-confirm-text: "OK";
    in-out property <string> dialog-cancel-text: "";
    callback dialog-confirmed();
    callback dialog-cancelled();

    callback open-clicked();
    callback add-album-clicked();
    callback reverse-queue-clicked();
    callback previous-clicked();
    callback play-pause-clicked();
    callback next-clicked();
    callback loop-clicked();
    callback add-source-clicked();
    callback remove-album-history-clicked(int);
    callback remove-track-history-clicked(int);
    callback queue-item-double-clicked(int);
    callback album-history-double-clicked(int);
    callback track-history-double-clicked(int);
    callback seek-drag-started();
    callback seek-drag-finished(float);
    callback key-space();
    callback key-seek(float);
    callback key-track-nav(bool);
    callback volume-changed(float);
    callback mute-changed(bool);

    forward-focus: shortcuts;

    shortcuts := FocusScope {
        key-released(event) => {
            if (event.text == Key.Control) {
                root.volume-boost-held = false;
                return accept;
            }
            reject
        }

        key-pressed(event) => {
            if (event.text == Key.Control) {
                root.volume-boost-held = true;
                return accept;
            }
            if (event.text == " ") {
                root.key-space();
                return accept;
            }
            if (event.text == Key.LeftArrow && event.modifiers.control) {
                root.key-track-nav(false);
                return accept;
            }
            if (event.text == Key.RightArrow && event.modifiers.control) {
                root.key-track-nav(true);
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.key-seek(-5);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.key-seek(5);
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 16px;
            spacing: 0px;

            // Title / status / badges
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: root.track-title;
                    color: #F3F3F3;
                    font-size: 26px;
                    font-weight: 600;
                    overflow: elide;
                }

                HorizontalLayout {
                    Text {
                        text: root.queue-info;
                        color: #A7A7A7;
                        font-size: 13px;
                        overflow: elide;
                    }
                    Rectangle { }
                    Text {
                        text: root.status;
                        color: #A7A7A7;
                        font-size: 13px;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Badge { text: root.source-badge; }
                    Badge { text: root.current-index-text; }
                    Badge { text: root.queue-count-text; }
                    Badge { text: root.loop-mode-badge; }
                }
            }

            // Source input row
            VerticalLayout {
                padding-top: 14px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    AppTextInput {
                        placeholder: "Paste a URL, file path, or folder path";
                        text <=> root.source-input;
                        enabled: root.is-source-input-enabled;
                        accepted => { root.add-source-clicked(); }
                    }
                    AppButton {
                        width: 92px;
                        text: "Add";
                        primary: true;
                        enabled: root.is-add-source-enabled;
                        clicked => { root.add-source-clicked(); }
                    }
                }

                if root.is-preparation-visible : Rectangle {
                    height: 4px;
                    background: #282828;
                    border-radius: 2px;
                    Rectangle {
                        width: 40%;
                        height: 100%;
                        background: #3A7AFE;
                        border-radius: 2px;
                    }
                }
            }

            // Seek
            Rectangle {
                height: 32px;
                SeekSlider {
                    y: 16px;
                    width: 100%;
                    maximum: root.seek-maximum;
                    value <=> root.seek-value;
                    drag-started => { root.seek-drag-started(); }
                    drag-finished(v) => { root.seek-drag-finished(v); }
                }
            }

            HorizontalLayout {
                padding-top: 8px;
                Text {
                    text: root.elapsed-text;
                    color: #CFCFCF;
                    font-size: 12px;
                }
                Rectangle { }
                Text {
                    text: root.remaining-text;
                    color: #CFCFCF;
                    font-size: 12px;
                }
            }

            // Transport buttons
            HorizontalLayout {
                padding-top: 16px;
                spacing: 8px;

                AppButton {
                    width: 72px;
                    text: "Open";
                    enabled: root.is-open-enabled;
                    clicked => { root.open-clicked(); }
                }
                AppButton {
                    width: 96px;
                    text: "Add Album";
                    enabled: root.is-add-album-enabled;
                    clicked => { root.add-album-clicked(); }
                }
                AppButton {
                    width: 82px;
                    text: "Reverse";
                    enabled: root.is-reverse-queue-enabled;
                    clicked => { root.reverse-queue-clicked(); }
                }
                AppButton {
                    width: 46px;
                    text: "|<";
                    enabled: root.is-previous-enabled;
                    clicked => { root.previous-clicked(); }
                }
                AppButton {
                    width: 76px;
                    text: root.play-pause-content;
                    primary: true;
                    enabled: root.is-play-pause-enabled;
                    clicked => { root.play-pause-clicked(); }
                }
                AppButton {
                    width: 46px;
                    text: ">|";
                    enabled: root.is-next-enabled;
                    clicked => { root.next-clicked(); }
                }
                AppButton {
                    width: 84px;
                    text: root.loop-button-content;
                    enabled: root.is-loop-enabled;
                    clicked => { root.loop-clicked(); }
                }
            }

            // Volume
            HorizontalLayout {
                padding-top: 12px;
                spacing: 10px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    VolumeIcon {
                        muted: root.volume-muted;
                        volume: root.volume-value;
                        clicked => {
                            root.volume-muted = !root.volume-muted;
                            root.mute-changed(root.volume-muted);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    VolumeSlider {
                        value <=> root.volume-value;
                        boost-unlocked <=> root.volume-boost-held;
                        muted: root.volume-muted;
                        changed(v) => {
                            // Adjusting the volume implicitly unmutes.
                            if (root.volume-muted) {
                                root.volume-muted = false;
                                root.mute-changed(false);
                            }
                            root.volume-changed(v);
                        }
                        escape-pressed => { shortcuts.focus(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 1px;
                        Text {
                            text: root.volume-display;
                            color: root.volume-text-color;
                            font-size: 12px;
                        }
                        Text {
                            text: "%";
                            color: root.volume-text-color;
                            font-size: 12px;
                        }
                    }
                }
            }

            // Tabs
            Rectangle {
                height: 260px;
                VerticalLayout {
                    padding-top: 16px;

                    TabWidget {
                        Tab {
                            title: "Queue";
                            VerticalLayout {
                                padding-top: 10px;
                                spacing: 10px;
                                Text {
                                    text: root.queue-summary;
                                    color: #A7A7A7;
                                    font-size: 12px;
                                }
                                Rectangle {
                                    background: #191919;
                                    border-color: #2F2F2F;
                                    border-width: 1px;
                                    ListView {
                                        for entry[i] in root.queue : QueueRow {
                                            item: entry;
                                            width: parent.width;
                                            double-clicked => { root.queue-item-double-clicked(i); }
                                        }
                                    }
                                }
                            }
                        }
                        Tab {
                            title: "Recent Albums";
                            Rectangle {
                                background: #191919;
                                border-color: #2F2F2F;
                                border-width: 1px;
                                ListView {
                                    for entry[i] in root.album-history : AlbumHistoryRow {
                                        item: entry;
                                        width: parent.width;
                                        remove-clicked => { root.remove-album-history-clicked(i); }
                                        double-clicked => { root.album-history-double-clicked(i); }
                                    }
                                }
                            }
                        }
                        Tab {
                            title: "Recent Tracks";
                            Rectangle {
                                background: #191919;
                                border-color: #2F2F2F;
                                border-width: 1px;
                                ListView {
                                    for entry[i] in root.track-history : TrackHistoryRow {
                                        item: entry;
                                        width: parent.width;
                                        remove-clicked => { root.remove-track-history-clicked(i); }
                                        double-clicked => { root.track-history-double-clicked(i); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "Space: Play/Pause  Left/Right: Seek  Ctrl+Left/Right: Track  Double click queue or history: Replay";
                    color: #8E8E8E;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Volume: icon = mute  click then Left/Right = 1%  Shift+Drag = 25% steps  Hold Ctrl = boost to 200%";
                    color: #8E8E8E;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    if root.dialog-visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000B0;

        // Swallows clicks outside the dialog box so the UI behind stays
        // inert while the dialog is up (ShowDialog-style modality).
        TouchArea {
            width: 100%;
            height: 100%;
        }

        Rectangle {
            width: min(440px, root.width - 40px);
            background: #161616;
            border-color: #353535;
            border-width: 1px;
            border-radius: 6px;
            height: dialog-content.preferred-height + 40px;

            dialog-content := VerticalLayout {
                x: 20px;
                y: 20px;
                width: parent.width - 40px;
                spacing: 18px;

                Text {
                    text: root.dialog-title;
                    color: #F3F3F3;
                    font-size: 16px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: root.dialog-message;
                    color: #F3F3F3;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;

                    if root.dialog-cancel-text != "" : AppButton {
                        width: max(96px, 40px + 8px * root.dialog-cancel-text.character-count);
                        text: root.dialog-cancel-text;
                        clicked => { root.dialog-cancelled(); }
                    }
                    AppButton {
                        width: max(96px, 40px + 8px * root.dialog-confirm-text.character-count);
                        text: root.dialog-confirm-text;
                        primary: true;
                        clicked => { root.dialog-confirmed(); }
                    }
                }
            }
        }
    }
}
