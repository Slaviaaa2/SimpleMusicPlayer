<Window x:Class="SimpleMusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Music Player"
        Height="260"
        Width="560"
        MinHeight="220"
        MinWidth="460"
        Background="#121212"
        Foreground="#F3F3F3"
        AllowDrop="True"
        Drop="Window_Drop">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MediaElement x:Name="Player"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      MediaOpened="Player_MediaOpened"
                      MediaEnded="Player_MediaEnded"
                      MediaFailed="Player_MediaFailed"
                      Volume="1"
                      Visibility="Collapsed" />

        <TextBlock x:Name="TrackTitleText"
                   Grid.Row="0"
                   FontSize="24"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Text="Drop files or use Open." />

        <TextBlock x:Name="QueueInfoText"
                   Grid.Row="1"
                   Margin="0,6,0,0"
                   Foreground="#B0B0B0"
                   Text="Supports mp3, wav, m4a, aac, flac, mp4, mov, wmv and more when Windows can decode them." />

        <Slider x:Name="SeekSlider"
                Grid.Row="2"
                Margin="0,18,0,0"
                Minimum="0"
                Maximum="1"
                PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                ValueChanged="SeekSlider_ValueChanged" />

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="ElapsedText"
                       DockPanel.Dock="Left"
                       Foreground="#CFCFCF"
                       Text="00:00" />
            <TextBlock x:Name="RemainingText"
                       DockPanel.Dock="Right"
                       Foreground="#CFCFCF"
                       Text="00:00" />
        </DockPanel>

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="OpenButton"
                    Grid.Column="0"
                    Width="68"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="OpenButton_Click"
                    Content="Open" />

            <Button x:Name="AddAlbumButton"
                    Grid.Column="1"
                    Width="92"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="AddAlbumButton_Click"
                    Content="Add Album" />

            <Button x:Name="PrevButton"
                    Grid.Column="2"
                    Width="44"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="PrevButton_Click"
                    Content="|&lt;" />

            <Button x:Name="PlayPauseButton"
                    Grid.Column="3"
                    Width="70"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="PlayPauseButton_Click"
                    Content="Play" />

            <Button x:Name="NextButton"
                    Grid.Column="4"
                    Width="44"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="NextButton_Click"
                    Content="&gt;|" />

            <Button x:Name="LoopButton"
                    Grid.Column="5"
                    Width="84"
                    Height="34"
                    Click="LoopButton_Click"
                    Content="Loop: All" />

            <TextBlock x:Name="HintText"
                       Grid.Column="7"
                       VerticalAlignment="Center"
                       Foreground="#9B9B9B"
                       Text="Space: Play/Pause  Left/Right: Seek  Ctrl+Left/Right: Track" />
        </Grid>
    </Grid>
</Window>
