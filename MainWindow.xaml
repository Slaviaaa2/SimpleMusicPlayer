<Window x:Class="SimpleMusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Music Player"
        Height="540"
        Width="760"
        MinHeight="420"
        MinWidth="560"
        Background="#121212"
        Foreground="#F3F3F3"
        FontFamily="Segoe UI"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#191919" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2F2F2F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A7A7A7" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3A7AFE" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4B88FF" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#232D3C" />

        <Style x:Key="BadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F3F3F3" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#303030" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2A63D0" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2A63D0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#181818" />
            <Setter Property="Foreground" Value="#F3F3F3" />
            <Setter Property="BorderBrush" Value="#353535" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#D8D8D8" />
            <Setter Property="Background" Value="#1C1C1C" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#232323" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#414141" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#191919" />
            <Setter Property="Foreground" Value="#F3F3F3" />
            <Setter Property="BorderBrush" Value="#2F2F2F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#1F1F1F"
                                BorderBrush="#313131"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4A4A4A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#282828" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MediaElement x:Name="Player"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      MediaOpened="Player_MediaOpened"
                      MediaEnded="Player_MediaEnded"
                      MediaFailed="Player_MediaFailed"
                      Volume="1"
                      Visibility="Collapsed" />

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TrackTitleText"
                       FontSize="26"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Text="Drop files or use Open." />

            <DockPanel Margin="0,6,0,0">
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Right"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Ready." />
                <TextBlock x:Name="QueueInfoText"
                           Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           Text="Supports local files, album folders, and yt-dlp-backed URL playback." />
            </DockPanel>

            <WrapPanel Margin="0,10,0,0">
                <Border Style="{StaticResource BadgeBorderStyle}">
                    <TextBlock x:Name="SourceBadgeText" Text="Standby" />
                </Border>
                <Border Style="{StaticResource BadgeBorderStyle}">
                    <TextBlock x:Name="CurrentIndexText" Text="Track --" />
                </Border>
                <Border Style="{StaticResource BadgeBorderStyle}">
                    <TextBlock x:Name="QueueCountText" Text="Queue empty" />
                </Border>
                <Border Style="{StaticResource BadgeBorderStyle}">
                    <TextBlock x:Name="LoopModeBadgeText" Text="Loop All" />
                </Border>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SourceInputTextBox"
                     Grid.Row="0"
                     Grid.Column="0"
                     VerticalContentAlignment="Center"
                     KeyDown="SourceInputTextBox_KeyDown"
                     ToolTip="Paste a URL, file path, or folder path" />

            <Button x:Name="AddSourceButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="92"
                    Margin="8,0,0,0"
                    Click="AddSourceButton_Click"
                    Content="Add"
                    Style="{StaticResource PrimaryButtonStyle}" />

            <ProgressBar x:Name="PreparationBar"
                         Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Margin="0,8,0,0"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
        </Grid>

        <Slider x:Name="SeekSlider"
                Grid.Row="2"
                Margin="0,16,0,0"
                Minimum="0"
                Maximum="1"
                PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                ValueChanged="SeekSlider_ValueChanged" />

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="ElapsedText"
                       DockPanel.Dock="Left"
                       Foreground="#CFCFCF"
                       Text="00:00" />
            <TextBlock x:Name="RemainingText"
                       DockPanel.Dock="Right"
                       Foreground="#CFCFCF"
                       Text="00:00" />
        </DockPanel>

        <WrapPanel Grid.Row="4" Margin="0,16,0,0">
            <Button x:Name="OpenButton"
                    Width="72"
                    Margin="0,0,8,8"
                    Click="OpenButton_Click"
                    Content="Open" />

            <Button x:Name="AddAlbumButton"
                    Width="96"
                    Margin="0,0,8,8"
                    Click="AddAlbumButton_Click"
                    Content="Add Album" />

            <Button x:Name="PrevButton"
                    Width="46"
                    Margin="0,0,8,8"
                    Click="PrevButton_Click"
                    Content="|&lt;" />

            <Button x:Name="PlayPauseButton"
                    Width="76"
                    Margin="0,0,8,8"
                    Click="PlayPauseButton_Click"
                    Content="Play"
                    Style="{StaticResource PrimaryButtonStyle}" />

            <Button x:Name="NextButton"
                    Width="46"
                    Margin="0,0,8,8"
                    Click="NextButton_Click"
                    Content="&gt;|" />

            <Button x:Name="LoopButton"
                    Width="84"
                    Margin="0,0,8,8"
                    Click="LoopButton_Click"
                    Content="Loop: All" />
        </WrapPanel>

        <TabControl Grid.Row="5" Margin="0,16,0,0">
            <TabItem Header="Queue">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="QueueSummaryText"
                               Foreground="{StaticResource MutedBrush}"
                               Text="0 queued" />

                    <ListBox x:Name="QueueList"
                             Grid.Row="1"
                             Margin="0,10,0,0"
                             MouseDoubleClick="QueueList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="48"
                                            Height="22"
                                            VerticalAlignment="Top"
                                            Background="#272727"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="#D6D6D6"
                                                   Text="{Binding SourceLabel}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="{Binding ContextText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Recent Albums">
                <ListBox x:Name="AlbumHistoryList"
                         Margin="0,10,0,0"
                         MouseDoubleClick="AlbumHistoryList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,8">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding AlbumPath}"
                                           TextTrimming="CharacterEllipsis" />
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Foreground="#B7B7B7"
                                               Text="{Binding TrackCountText}" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Foreground="#B7B7B7"
                                               Text="{Binding LastPlayedText}" />
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Recent Tracks">
                <ListBox x:Name="TrackHistoryList"
                         Margin="0,10,0,0"
                         MouseDoubleClick="TrackHistoryList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,8">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding ContextText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="#B7B7B7"
                                           Text="{Binding LastPlayedText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="6"
                   Margin="0,12,0,0"
                   Foreground="#8E8E8E"
                   Text="Space: Play/Pause  Left/Right: Seek  Ctrl+Left/Right: Track  Double click queue or history: Replay" />
    </Grid>
</Window>
