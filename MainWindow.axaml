<Window x:Class="SimpleMusicPlayer.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SimpleMusicPlayer"
        Title="Simple Music Player"
        Width="760"
        Height="540"
        MinWidth="560"
        MinHeight="420"
        Background="#121212"
        Foreground="#F3F3F3">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#262626" />
            <Setter Property="Foreground" Value="#F3F3F3" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#3A7AFE" />
            <Setter Property="BorderBrush" Value="#3A7AFE" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#181818" />
            <Setter Property="Foreground" Value="#F3F3F3" />
            <Setter Property="BorderBrush" Value="#353535" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="#191919" />
            <Setter Property="Foreground" Value="#F3F3F3" />
            <Setter Property="BorderBrush" Value="#2F2F2F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="#3A7AFE" />
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Height" Value="4" />
        </Style>
    </Window.Styles>

    <Grid Margin="16"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0"
                    Spacing="6">
            <TextBlock x:Name="TrackTitleText"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Text="Drop files or use Open."
                       TextTrimming="CharacterEllipsis" />

            <DockPanel>
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Right"
                           Foreground="#A7A7A7"
                           Text="Ready." />
                <TextBlock x:Name="QueueInfoText"
                           Foreground="#A7A7A7"
                           Text="Supports local files, album folders, and yt-dlp-backed URL playback."
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <WrapPanel Margin="0,4,0,0">
                <Border Margin="0,0,8,8"
                        Padding="8,4"
                        Background="#202020"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="10">
                    <TextBlock x:Name="SourceBadgeText"
                               Text="Standby" />
                </Border>
                <Border Margin="0,0,8,8"
                        Padding="8,4"
                        Background="#202020"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="10">
                    <TextBlock x:Name="CurrentIndexText"
                               Text="Track --" />
                </Border>
                <Border Margin="0,0,8,8"
                        Padding="8,4"
                        Background="#202020"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="10">
                    <TextBlock x:Name="QueueCountText"
                               Text="Queue empty" />
                </Border>
                <Border Margin="0,0,8,8"
                        Padding="8,4"
                        Background="#202020"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="10">
                    <TextBlock x:Name="LoopModeBadgeText"
                               Text="Loop All" />
                </Border>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,14,0,0"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,Auto">
            <TextBox x:Name="SourceInputTextBox"
                     Grid.Row="0"
                     Grid.Column="0"
                     VerticalContentAlignment="Center"
                     Watermark="Paste a URL, file path, or folder path" />

            <Button x:Name="AddSourceButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="92"
                    Margin="8,0,0,0"
                    Classes="primary"
                    Content="Add" />

            <ProgressBar x:Name="PreparationBar"
                         Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Margin="0,8,0,0"
                         IsIndeterminate="True"
                         IsVisible="False" />
        </Grid>

        <Slider x:Name="SeekSlider"
                Grid.Row="2"
                Margin="0,16,0,0"
                Minimum="0"
                Maximum="1" />

        <DockPanel Grid.Row="3"
                   Margin="0,8,0,0">
            <TextBlock x:Name="ElapsedText"
                       DockPanel.Dock="Left"
                       Foreground="#CFCFCF"
                       Text="00:00" />
            <TextBlock x:Name="RemainingText"
                       DockPanel.Dock="Right"
                       Foreground="#CFCFCF"
                       Text="00:00" />
        </DockPanel>

        <WrapPanel Grid.Row="4"
                   Margin="0,16,0,0">
            <Button x:Name="OpenButton"
                    Width="72"
                    Margin="0,0,8,8"
                    Content="Open" />

            <Button x:Name="AddAlbumButton"
                    Width="96"
                    Margin="0,0,8,8"
                    Content="Add Album" />

            <Button x:Name="PrevButton"
                    Width="46"
                    Margin="0,0,8,8"
                    Content="|&lt;" />

            <Button x:Name="PlayPauseButton"
                    Width="76"
                    Margin="0,0,8,8"
                    Classes="primary"
                    Content="Play" />

            <Button x:Name="NextButton"
                    Width="46"
                    Margin="0,0,8,8"
                    Content="&gt;|" />

            <Button x:Name="LoopButton"
                    Width="84"
                    Margin="0,0,8,8"
                    Content="Loop: All" />
        </WrapPanel>

        <TabControl Grid.Row="5"
                    Margin="0,16,0,0">
            <TabItem Header="Queue">
                <Grid Margin="0,10,0,0"
                      RowDefinitions="Auto,*">
                    <TextBlock x:Name="QueueSummaryText"
                               Foreground="#A7A7A7"
                               Text="0 queued" />

                    <ListBox x:Name="QueueList"
                             Grid.Row="1"
                             Margin="0,10,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8"
                                      ColumnDefinitions="Auto,*">
                                    <Border Width="48"
                                            Height="22"
                                            VerticalAlignment="Top"
                                            Background="#272727"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="#D6D6D6"
                                                   Text="{Binding SourceLabel}" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Spacing="3">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="#A7A7A7"
                                                   Text="{Binding ContextText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Recent Albums">
                <ListBox x:Name="AlbumHistoryList"
                         Margin="0,10,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,8"
                                        Spacing="3">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="#A7A7A7"
                                           Text="{Binding AlbumPath}"
                                           TextTrimming="CharacterEllipsis" />
                                <DockPanel Margin="0,3,0,0">
                                    <TextBlock Foreground="#B7B7B7"
                                               Text="{Binding TrackCountText}" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Foreground="#B7B7B7"
                                               Text="{Binding LastPlayedText}" />
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Recent Tracks">
                <ListBox x:Name="TrackHistoryList"
                         Margin="0,10,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,8"
                                        Spacing="3">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="#A7A7A7"
                                           Text="{Binding ContextText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="#B7B7B7"
                                           Text="{Binding LastPlayedText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="6"
                   Margin="0,12,0,0"
                   Foreground="#8E8E8E"
                   Text="Space: Play/Pause  Left/Right: Seek  Ctrl+Left/Right: Track  Double click queue or history: Replay" />
    </Grid>
</Window>
